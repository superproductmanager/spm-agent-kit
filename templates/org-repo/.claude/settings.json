{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/install-kit.sh\" 0.1.0 REPLACE_WITH_SHA256_FROM_SHA256SUMS && bash \"${SPM_AGENT_KIT_DIR:-$HOME/spm-agent-kit}/cloud-agent-setup.sh\" --apply"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node */spm-agent-kit/agent-reply.cjs *)",
      "Bash(node */spm-agent-kit/agent-ack.cjs *)",
      "Bash(node */spm-agent-kit/agent-resolve.cjs *)",
      "Bash(node */spm-agent-kit/agent-relay.cjs *)",
      "Bash(bash */spm-agent-kit/start.sh *)"
    ]
  }
}
